<Window x:Class="NotifyHub.UI.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotifyHub 通知"
        Width="384" Height="140"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" Focusable="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal"
        FontFamily="SF Pro Display SC, SF Pro Display, SF Pro Text, PingFang SC, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="Manual">

    <!--
      macOS 原生通知样式（深色毛玻璃版）：
        顶部：应用图标 + 来源名称（微信 / QQ / NTFY）
        中间：会话名称（好友昵称 / 群名）
        主体：消息预览（单行，超长末尾省略，不折行撑大弹窗）
        底部：时间标签
      圆角 20，柔和外阴影，与灵动岛 / 音乐悬浮条同一视觉体系。

      Margin 14 必须 ≥ 阴影扩散范围（blur 12 + depth 2），否则阴影会被窗口矩形裁成
      一圈灰白硬边——之前"毛玻璃外多了个方框"就是这个原因。
    -->
    <Border x:Name="Card" Margin="14" CornerRadius="20"
            BorderBrush="#26FFFFFF" BorderThickness="1"
            Cursor="Hand" MouseLeftButtonUp="OnCardClick" MouseRightButtonUp="OnCardRightClick">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.32" Color="#FF000000" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardTransform" X="40" />
        </Border.RenderTransform>

        <!--  毛玻璃质感：深色半透明 + 顶部极淡高光渐变  -->
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FA2A2A2F" Offset="0" />
                <GradientStop Color="#F21B1B1F" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="16,13,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  顶部：应用图标 + 来源名称  -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="AppIcon" Width="18" Height="18" CornerRadius="5"
                        VerticalAlignment="Center" Background="#07C160">
                    <TextBlock x:Name="IconGlyph" Text="微" FontSize="10.5" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="AppNameText" Margin="8,0,0,0" FontSize="12" FontWeight="Medium"
                           Foreground="#C7C7CC" VerticalAlignment="Center" Text="微信" />
            </StackPanel>

            <!--  中间：会话名称  -->
            <TextBlock x:Name="SenderText" Grid.Row="1" Margin="0,7,0,0" FontSize="15"
                       FontWeight="SemiBold" Foreground="#FFFFFF"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

            <!--  主体：消息预览（单行省略）  -->
            <TextBlock x:Name="ContentText" Grid.Row="2" Margin="0,4,0,0" FontSize="13"
                       Foreground="#B9B9C0" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" VerticalAlignment="Center" />

            <!--  底部：时间标签  -->
            <TextBlock x:Name="TimeText" Grid.Row="3" Margin="0,5,0,0" FontSize="11"
                       Foreground="#8A8A90" Text="00:00" />
        </Grid>
    </Border>
</Window>

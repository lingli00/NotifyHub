<Window x:Class="NotifyHub.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotifyHub.UI"
        Title="NotifyHub 灵动岛"
        SizeToContent="WidthAndHeight" MaxWidth="820"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" Focusable="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!--  播放控件图标一律用矢量 Path 绘制：不依赖任何图标字体，
             避免缺字时按钮变成豆腐方块（Segoe MDL2 Assets 在精简系统上可能缺失）  -->
        <Geometry x:Key="GlyphPrev">M0,0 L2.3,0 L2.3,12 L0,12 Z M11,0.6 L11,11.4 L3,6 Z</Geometry>
        <Geometry x:Key="GlyphNext">M0,0.6 L0,11.4 L8,6 Z M8.7,0 L11,0 L11,12 L8.7,12 Z</Geometry>
        <Geometry x:Key="GlyphPlay">M0.8,0.4 L11.2,6 L0.8,11.6 Z</Geometry>
        <Geometry x:Key="GlyphPause">M0.8,0 L4,0 L4,12 L0.8,12 Z M7.4,0 L10.6,0 L10.6,12 L7.4,12 Z</Geometry>

        <!--  岛内快捷按钮：点击区域 36×36，透明底、悬停微亮，不抢焦点  -->
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="#F2F2F7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
      统一深色毛玻璃圆角长条：音乐信息 + 播放控件 + 单行任务状态共处一个面板。
      [♪] 歌名-歌手 | [⏮] [⏯] [⏭] | 一行实时动作

      v0.2.2：去掉 DropShadowEffect——它会强制整个条体走软件渲染路径，
      弹出动画掉帧、不跟手的元凶就是它。深度感由渐变底 + 1px 高光描边承担，
      透明留白区保留（Win32 侧 HTTRANSPARENT 放行鼠标，不挡下层窗口）。
    -->
    <Border x:Name="Pill" Margin="14" CornerRadius="22" BorderBrush="#26FFFFFF" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F23A3A40" Offset="0" />
                <GradientStop Color="#F22C2C31" Offset="0.35" />
                <GradientStop Color="#EE0F0F12" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.RenderTransform>
            <TranslateTransform x:Name="IslandShift" Y="-10" />
        </Border.RenderTransform>

        <Grid Height="48" Margin="6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  音乐组：App 图标 + 歌名（跑马灯）+ 三个控件  -->
            <StackPanel x:Name="MusicGroup" Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="6,0,2,0">
                <!--  当前播放音乐 App 的透明圆角图标（需求 5）：无播放/提不到图标时收起  -->
                <Border x:Name="MusicIconBox" Width="20" Height="20" CornerRadius="6"
                        VerticalAlignment="Center" Margin="0,0,7,0" Visibility="Collapsed">
                    <Image x:Name="MusicAppIcon" Width="20" Height="20" Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="MusicGlyph" Text="&#x266A;" FontSize="15" Foreground="#FFD60A"
                           VerticalAlignment="Center" Margin="4,0,7,0" />
                <local:MarqueeText x:Name="MusicText" Width="180" FontSize="12.5" Foreground="#F2F2F7"
                           VerticalAlignment="Center" Text="正在播放" />
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="PrevButton" Style="{StaticResource IslandButton}"
                            Click="OnPrevClick" ToolTip="上一首">
                        <Path Data="{StaticResource GlyphPrev}" Fill="#F2F2F7" Width="12" Height="12"
                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource IslandButton}"
                            Margin="2,0" Click="OnPlayPauseClick" ToolTip="播放 / 暂停">
                        <Path x:Name="PlayPauseGlyph" Data="{StaticResource GlyphPlay}" Fill="#F2F2F7"
                              Width="12" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource IslandButton}"
                            Click="OnNextClick" ToolTip="下一首">
                        <Path Data="{StaticResource GlyphNext}" Fill="#F2F2F7" Width="12" Height="12"
                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <!--  两组之间的细分隔线  -->
            <Border x:Name="Divider" Grid.Column="1" Width="1" Height="20" Background="#33FFFFFF"
                    Margin="8,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" />

            <!--  单行任务组：状态点 / 对勾 + 一行实时动作文字（只许一行，超长末尾省略）  -->
            <StackPanel x:Name="StatusGroup" Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="4,0,12,0">
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FFB020" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="DotScale" ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Path x:Name="CheckGlyph" Data="M1,6.6 L4.6,10.4 L11,1.8" Stroke="#34C759"
                          StrokeThickness="2.1" Width="12" Height="12" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Visibility="Collapsed" HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>

                <!--  任务状态文字：跑马灯（超宽横滚、悬停暂停、短文本居中）  -->
                <local:MarqueeText x:Name="StatusText" Width="440" FontSize="13"
                           Foreground="#F2F2F7" VerticalAlignment="Center" Margin="9,0,12,0"
                           Text="正在执行任务…" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="NotifyHub.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotifyHub.UI"
        Title="NotifyHub 灵动岛"
        SizeToContent="WidthAndHeight" MaxWidth="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" Focusable="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!--  播放控件图标一律用矢量 Path 绘制：不依赖任何图标字体，
             避免缺字时按钮变成豆腐方块（Segoe MDL2 Assets 在精简系统上可能缺失）  -->
        <Geometry x:Key="GlyphPrev">M0,0 L2.3,0 L2.3,12 L0,12 Z M11,0.6 L11,11.4 L3,6 Z</Geometry>
        <Geometry x:Key="GlyphNext">M0,0.6 L0,11.4 L8,6 Z M8.7,0 L11,0 L11,12 L8.7,12 Z</Geometry>
        <Geometry x:Key="GlyphPlay">M0.8,0.4 L11.2,6 L0.8,11.6 Z</Geometry>
        <Geometry x:Key="GlyphPause">M0.8,0 L4,0 L4,12 L0.8,12 Z M7.4,0 L10.6,0 L10.6,12 L7.4,12 Z</Geometry>

        <!--  v0.2.6 主题画刷：由 ThemePalette 在运行时替换（DynamicResource 会跟着刷新）  -->
        <SolidColorBrush x:Key="IslandFg" Color="#F2F2F7" />
        <SolidColorBrush x:Key="IslandSubFg" Color="#B9B9C0" />
        <SolidColorBrush x:Key="IslandGlyph" Color="#F2F2F7" />
        <SolidColorBrush x:Key="IslandHover" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="IslandPress" Color="#55FFFFFF" />
        <SolidColorBrush x:Key="IslandAccent" Color="#FFD60A" />
        <SolidColorBrush x:Key="IslandDivider" Color="#33FFFFFF" />

        <!--  岛内快捷按钮：点击区域 36×36，透明底、悬停微亮，不抢焦点  -->
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{DynamicResource IslandFg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IslandHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IslandPress}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
      v0.2.7 布局重排（需求 1）：两栏「等信息量」结构，左右视觉配平。

        左栏（音乐 + 歌词）
          第 0 行： [App图标/♪] 歌名-歌手 ········ [⏮][⏯][⏭]
          第 1 行： 当前歌词（字号 +1.5，满亮度，半粗）
                    下一行歌词（字号 -1.5，55% 亮度）
        中间   ： 1px 竖分隔线（仅两侧都有内容时出现）
        右栏（WorkBuddy 任务，跨两行垂直居中）
          第 0 行： ● WorkBuddy   ← 小号标签，弱化
          第 1 行： 正在执行的动作  ← 正文（跑马灯，超宽横滚）

      为什么这样改：v0.2.6 右侧是一条 440px 的宽文字 + 左侧 286px 歌词，
      有任务时整条岛被撑到 810px 且左右比例失衡（左挤右空）。现在两侧都按
      「标签 + 正文」双行组织，宽度在代码里按内容配平（LeftWidth ≈ RightWidth），
      有任务时岛宽稳定在 660 左右，无任务时左侧自然收窄。
    -->
    <Border x:Name="Pill" Margin="14" CornerRadius="22" BorderBrush="#26FFFFFF" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F23A3A40" Offset="0" />
                <GradientStop Color="#F22C2C31" Offset="0.35" />
                <GradientStop Color="#EE0F0F12" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.RenderTransform>
            <TranslateTransform x:Name="IslandShift" Y="-10" />
        </Border.RenderTransform>

        <Grid>
            <!--  毛玻璃顶部高光：一条极淡的白色渐变，让半透明面板有“玻璃”的层次  -->
            <Border x:Name="HighlightLayer" CornerRadius="22" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#14FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.5" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="12,0,12,0" MinHeight="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <!--  单行 + 星号高度：只显示右侧任务时（左侧全收起）也能撑住垂直居中  -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  ============ 左栏：音乐行 + 双行歌词（垂直堆叠）  ============  -->
                <StackPanel x:Name="LeftPane" Grid.Column="0" Orientation="Vertical"
                            VerticalAlignment="Center">
                    <!--  第 0 行：音乐组  -->
                    <Grid x:Name="MusicGroup" Height="46" Margin="2,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  标题：App 图标 / ♪ + 歌名-歌手（跑马灯）  -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="MusicIconBox" Width="18" Height="18" CornerRadius="5"
                                    VerticalAlignment="Center" Margin="0,0,7,0" Visibility="Collapsed">
                                <Image x:Name="MusicAppIcon" Width="18" Height="18" Stretch="Uniform" />
                            </Border>
                            <TextBlock x:Name="MusicGlyph" Text="&#x266A;" FontSize="14"
                                       Foreground="{DynamicResource IslandAccent}"
                                       VerticalAlignment="Center" Margin="2,0,7,0" />
                            <local:MarqueeText x:Name="MusicText" Width="152" FontSize="12.5"
                                               Foreground="{DynamicResource IslandFg}"
                                               VerticalAlignment="Center" Text="正在播放" />
                        </StackPanel>

                        <!--  播放三键：上一首 / 播放暂停 / 下一首  -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                            <Button x:Name="PrevButton" Style="{StaticResource IslandButton}"
                                    Click="OnPrevClick" ToolTip="上一首">
                                <Path Data="{StaticResource GlyphPrev}" Fill="{DynamicResource IslandGlyph}"
                                      Width="11" Height="11" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource IslandButton}"
                                    Margin="2,0" Click="OnPlayPauseClick" ToolTip="播放 / 暂停">
                                <Path x:Name="PlayPauseGlyph" Data="{StaticResource GlyphPlay}"
                                      Fill="{DynamicResource IslandGlyph}"
                                      Width="11" Height="11" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="NextButton" Style="{StaticResource IslandButton}"
                                    Click="OnNextClick" ToolTip="下一首">
                                <Path Data="{StaticResource GlyphNext}" Fill="{DynamicResource IslandGlyph}"
                                      Width="11" Height="11" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--  第 1 行：双行歌词（强调竖条 + 当前行/下一行）  -->
                    <Grid x:Name="LyricsPanel" Margin="2,0,0,9" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="LyricBar" Grid.Column="0" Width="2" CornerRadius="1"
                                Background="{DynamicResource IslandAccent}" Opacity="0.5"
                                Margin="0,3,23,3" />

                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <local:MarqueeText x:Name="LyricLine1" Width="270" FontSize="13"
                                               Foreground="{DynamicResource IslandFg}"
                                               VerticalAlignment="Center" Text="" />
                            <local:MarqueeText x:Name="LyricLine2" Width="270" FontSize="10.5"
                                               Foreground="{DynamicResource IslandSubFg}" Opacity="0.75"
                                               Margin="0,2,0,0" VerticalAlignment="Center" Text="" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!--  ============ 中间竖分隔线  ============  -->
                <Border x:Name="Divider" Grid.Column="1" Width="1" Height="24"
                        Background="{DynamicResource IslandDivider}"
                        Margin="12,0,12,0" VerticalAlignment="Center" Visibility="Collapsed" />

                <!--  ============ 右栏：WorkBuddy 任务（标签 + 正文）  ============  -->
                <StackPanel x:Name="StatusGroup" Grid.Column="2" Orientation="Vertical"
                            VerticalAlignment="Center" Margin="0,1,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  标签行：状态点 / 完成对勾 + 来源标签  -->
                        <Grid Grid.Row="0" Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#FFB020"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="DotScale" ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Path x:Name="CheckGlyph" Data="M1,6.6 L4.6,10.4 L11,1.8" Stroke="#34C759"
                                  StrokeThickness="2.2" Width="12" Height="12" Stretch="Uniform"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="StatusTag" Grid.Row="0" Grid.Column="1" Text="WorkBuddy"
                                   FontSize="10" Margin="6,0,0,0" Foreground="{DynamicResource IslandSubFg}"
                                   Opacity="0.85" VerticalAlignment="Center" />

                        <!--  正文：一行实时动作（跑马灯，超宽横滚、悬停暂停、短文本左对齐）  -->
                        <local:MarqueeText x:Name="StatusText" Grid.Row="1" Grid.Column="1" Width="262"
                                           FontSize="12.5" Foreground="{DynamicResource IslandFg}"
                                           Margin="6,2,0,0" VerticalAlignment="Center" Text="正在执行任务…" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

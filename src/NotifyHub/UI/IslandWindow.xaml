<Window x:Class="NotifyHub.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotifyHub.UI"
        Title="NotifyHub 灵动岛"
        SizeToContent="Manual"
        Width="508" Height="136"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" Focusable="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!--  播放控件图标一律用矢量 Path 绘制：不依赖任何图标字体，
             避免缺字时按钮变成豆腐方块（Segoe MDL2 Assets 在精简系统上可能缺失）  -->
        <Geometry x:Key="GlyphPrev">M0,0 L2.3,0 L2.3,12 L0,12 Z M11,0.6 L11,11.4 L3,6 Z</Geometry>
        <Geometry x:Key="GlyphNext">M0,0.6 L0,11.4 L8,6 Z M8.7,0 L11,0 L11,12 L8.7,12 Z</Geometry>
        <Geometry x:Key="GlyphPlay">M0.8,0.4 L11.2,6 L0.8,11.6 Z</Geometry>
        <Geometry x:Key="GlyphPause">M0.8,0 L4,0 L4,12 L0.8,12 Z M7.4,0 L10.6,0 L10.6,12 L7.4,12 Z</Geometry>

        <!--  v0.2.6 主题画刷：由 ThemePalette 在运行时替换（DynamicResource 会跟着刷新）  -->
        <SolidColorBrush x:Key="IslandFg" Color="#F2F2F7" />
        <SolidColorBrush x:Key="IslandSubFg" Color="#B9B9C0" />
        <SolidColorBrush x:Key="IslandGlyph" Color="#F2F2F7" />
        <SolidColorBrush x:Key="IslandHover" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="IslandPress" Color="#55FFFFFF" />
        <SolidColorBrush x:Key="IslandAccent" Color="#FFD60A" />
        <SolidColorBrush x:Key="IslandDivider" Color="#33FFFFFF" />

        <!--  岛内快捷按钮：点击区域 36×36，透明底、悬停微亮，不抢焦点  -->
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{DynamicResource IslandFg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IslandHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IslandPress}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
          岛内信息行按钮（通知行）：整行可点、透明底，命中判定走 Button。

          v0.2.10 需求 3：**去掉悬停/按下的底色**。
          浅色毛玻璃下 IslandHover 是「黑 12%」，铺在整行上就是一条明显的黑色遮罩，
          鼠标一过整条消息像被"选中"了一样。现在悬停反馈统一交给整岛轻微放大（见 OnPillMouseEnter）。
        -->
        <Style x:Key="IslandRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBd" CornerRadius="7" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
      v0.2.8 播放器 + 歌词区域重做（需求 2/5）。

      旧版别扭的地方：
        · 音乐行固定 46 高，歌名被顶在上面，和下面的歌词之间空一大块；
        · 歌词左侧一根 2px 竖条 + 23px 空白，文字起点和歌名对不上，看起来像"缩进错了"；
        · 歌词两行都是固定 270 宽，歌词短的时候右侧留一大片黑，
          岛还是按这个固定宽居中 → 视觉上明显靠左；
        · 三行内容（当前/下一句）层次只靠字号，读起来分不清主次。

      现在的结构：一条贯穿的强调脊线 + 一个统一缩进的内容列
        ┃ [图标] 歌名 - 歌手 ............  ⏮ ⏯ ⏭
        ┃ 当前歌词（加粗、满亮度）
        ┃ 译文（可选，小一号、次亮）      ← 只有歌词源自带翻译时才出现
        ┃ 下一句（小一号、更暗）
      所有文字共用同一个左边界（脊线右侧 10px），宽度按文本实测自适应（见 BalanceWidths）。
    -->
    <Border x:Name="Pill" Margin="14" CornerRadius="22" BorderBrush="#26FFFFFF" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F23A3A40" Offset="0" />
                <GradientStop Color="#F22C2C31" Offset="0.35" />
                <GradientStop Color="#EE0F0F12" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.RenderTransform>
            <!--  v0.2.10 需求 3：悬停整岛轻微放大（≈2.5%，回弹缓动），不加遮罩、不变色  -->
            <TransformGroup>
                <ScaleTransform x:Name="PillHoverScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="IslandShift" Y="-10" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>

        <!--  v0.2.18：岛改成固定尺寸模型——窗口大小由「总长度/整体高度」设置严格决定，
              内容再长也只在岛内裁剪/滚动，绝不被撑大。外层 Grid 负责裁剪溢出内容。  -->
        <Grid ClipToBounds="True">
            <!--  毛玻璃顶部高光：一条极淡的白色渐变，让半透明面板有"玻璃"的层次  -->
            <Border x:Name="HighlightLayer" CornerRadius="22" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#14FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.5" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!--  上下 10 / 8 的内边距：内容不再贴边，视觉更松。
                  v0.2.18：整体居中（固定尺寸下短内容不会贴左），纵向留白与行高
                  按「整体高度」缩放（ApplyLayoutMetrics）；溢出由外层裁剪。
                  v0.2.18 修：纵向改为 Stretch —— 强调脊线/分隔线要吃满岛高，
                  否则岛拉高后条子只有中间一小截、上方留一大片空白；
                  岛压矮时条子又被挤没。  -->
            <Grid x:Name="ContentGrid" Margin="12,9,12,9" MinHeight="36"
                  HorizontalAlignment="Center" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  ============ 左栏：强调脊线 + 音乐行 + 歌词  ============  -->
                <Grid x:Name="LeftPane" Grid.Column="0" MinHeight="46" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  贯穿脊线：高度跟着岛高走（Stretch），短岛也看得见、长岛不留空白  -->
                    <Border x:Name="AccentSpine" Grid.Column="0" Width="3" CornerRadius="1.5"
                            Background="{DynamicResource IslandAccent}" Opacity="0.8"
                            VerticalAlignment="Stretch" Margin="0,3,0,3" />

                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="10,0,0,0"
                                VerticalAlignment="Center">

                        <!--  第 0 行：音频行（图标 + 歌名 + 三键），高度按内容自适应  -->
                        <Grid x:Name="MusicGroup" MinHeight="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="MusicIconBox" Width="17" Height="17" CornerRadius="5"
                                        VerticalAlignment="Center" Margin="0,0,7,0" Visibility="Collapsed">
                                    <Image x:Name="MusicAppIcon" Width="17" Height="17" Stretch="Uniform" />
                                </Border>
                                <TextBlock x:Name="MusicGlyph" Text="&#x266A;" FontSize="13"
                                           Foreground="{DynamicResource IslandAccent}"
                                           VerticalAlignment="Center" Margin="1,0,6,0" />
                                <local:MarqueeText x:Name="MusicText" Width="152" FontSize="12.5"
                                                   Foreground="{DynamicResource IslandSubFg}"
                                                   VerticalAlignment="Center" Text="正在播放" />
                            </StackPanel>

                            <!--  播放三键：32×32，比旧版 36 收紧，行内更紧凑  -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="7,0,0,0"
                                        VerticalAlignment="Center">
                                <Button x:Name="PrevButton" Style="{StaticResource IslandButton}"
                                        Width="32" Height="32" Click="OnPrevClick" ToolTip="上一首">
                                    <Path Data="{StaticResource GlyphPrev}" Fill="{DynamicResource IslandGlyph}"
                                          Width="10" Height="10" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <Button x:Name="PlayPauseButton" Style="{StaticResource IslandButton}"
                                        Width="32" Height="32" Margin="1,0" Click="OnPlayPauseClick"
                                        ToolTip="播放 / 暂停">
                                    <Path x:Name="PlayPauseGlyph" Data="{StaticResource GlyphPlay}"
                                          Fill="{DynamicResource IslandGlyph}"
                                          Width="10" Height="10" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <Button x:Name="NextButton" Style="{StaticResource IslandButton}"
                                        Width="32" Height="32" Click="OnNextClick" ToolTip="下一首">
                                    <Path Data="{StaticResource GlyphNext}" Fill="{DynamicResource IslandGlyph}"
                                          Width="10" Height="10" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  第 1 行：歌词（当前 / 译文 / 下一句，宽度由代码按文本实测）  -->
                        <!--  左缩进 24 = 图标 17 + 间距 7，让歌词左边界与歌名文字对齐；
                               运行时 BalanceWidths 会按实测位置再校正一次  -->
                        <StackPanel x:Name="LyricsPanel" Orientation="Vertical" Margin="24,4,0,1"
                                    Visibility="Collapsed">
                            <local:MarqueeText x:Name="LyricLine1" Width="270" FontSize="14"
                                               Foreground="{DynamicResource IslandFg}"
                                               VerticalAlignment="Center" Text="" />
                            <local:MarqueeText x:Name="LyricTrans" Width="270" FontSize="11"
                                               Foreground="{DynamicResource IslandSubFg}" Opacity="0.8"
                                               Margin="0,1,0,0" VerticalAlignment="Center"
                                               Visibility="Collapsed" Text="" />
                            <local:MarqueeText x:Name="LyricLine2" Width="270" FontSize="11"
                                               Foreground="{DynamicResource IslandSubFg}" Opacity="0.55"
                                               Margin="0,1,0,0" VerticalAlignment="Center" Text="" />
                        </StackPanel>

                        <!--
                          歌词占位（v0.2.12 需求 3）：待机态"歌名/歌手/歌词区域留空"，
                          显式留一条占位，左右两栏高度才统一（不再是左矮右高一截）。
                        -->
                        <Border x:Name="LyricSpacer" Height="17" Margin="24,4,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <!--  ============ 中间竖分隔线  ============  -->
                <!--  v0.2.18：高度跟岛高一起伸缩（MinHeight 24 保底），不再固定 24px 居中一条短线  -->
                <Border x:Name="Divider" Grid.Column="1" Width="1" MinHeight="24"
                        Background="{DynamicResource IslandDivider}"
                        Margin="12,10,12,10" VerticalAlignment="Stretch" Visibility="Collapsed" />

                <!--  ============ 右栏：WorkBuddy 任务 + 通知（v0.2.9 需求 3）  ============  -->
                <StackPanel x:Name="RightPane" Grid.Column="2" Orientation="Vertical"
                            VerticalAlignment="Center" MinHeight="46" Margin="0,1,0,1"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <!--  v0.2.18 需求1：模块在岛内的上下位置偏移（不参与布局，纯视觉位移）  -->
                        <TranslateTransform x:Name="RightPaneShift" Y="0" />
                    </StackPanel.RenderTransform>

                    <!--
                      WorkBuddy 在线行（v0.2.12 需求 3：待机态走"左右分裂"布局）。

                      左栏留给播放器（图标 + 歌名/歌词占位 + 三个播放键），右栏只放
                      WorkBuddy / 通知 —— 这就是图二的形态。旧版把"音乐"也塞在右栏里，
                      于是两行小黄标签挤在一起、文字居中，观感很差。
                    -->
                    <StackPanel x:Name="PresenceWbRow" Orientation="Vertical" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center">
                                <Ellipse x:Name="PresenceWbDot" Width="7" Height="7" Fill="#FFB020" />
                            </Grid>

                            <!--
                              需求 2：标签原来是 #FFB020 的淡黄小字（10px + 0.95 透明度），
                              在深色毛玻璃上又细又糊。现在改成近白的冷色 + 半粗 + 11px，
                              点仍保留品牌琥珀，身份色靠点表达，文字只负责"看清"。
                            -->
                            <TextBlock x:Name="PresenceWbTag" Grid.Row="0" Grid.Column="1" Text="WorkBuddy"
                                       FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"
                                       Foreground="{DynamicResource IslandFg}" Opacity="1"
                                       VerticalAlignment="Center" />

                            <local:MarqueeText x:Name="PresenceWbText" Grid.Row="1" Grid.Column="1" Width="200"
                                               FontSize="12.5" Foreground="{DynamicResource IslandFg}"
                                               Margin="6,2,0,0" VerticalAlignment="Center" Text="" />
                        </Grid>
                    </StackPanel>

                    <!--  任务行（琥珀状态点 + 来源标签 + 一行实时动作）  -->
                    <StackPanel x:Name="StatusGroup" Orientation="Vertical">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  标签行：状态点 / 完成对勾 + 来源标签  -->
                            <Grid Grid.Row="0" Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#FFB020"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="DotScale" ScaleX="1" ScaleY="1" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Path x:Name="CheckGlyph" Data="M1,6.6 L4.6,10.4 L11,1.8" Stroke="#34C759"
                                      StrokeThickness="2.2" Width="12" Height="12" Stretch="Uniform"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock x:Name="StatusTag" Grid.Row="0" Grid.Column="1" Text="WorkBuddy"
                                       FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"
                                       Foreground="{DynamicResource IslandFg}" Opacity="1" VerticalAlignment="Center" />

                            <!--  正文：一行实时动作（跑马灯，超宽横滚、悬停暂停、短文本左对齐）  -->
                            <local:MarqueeText x:Name="StatusText" Grid.Row="1" Grid.Column="1" Width="262"
                                               FontSize="12.5" Foreground="{DynamicResource IslandFg}"
                                               Margin="6,2,0,0" VerticalAlignment="Center" Text="正在执行任务…" />
                        </Grid>
                    </StackPanel>

                    <!--
                      通知行（v0.2.9 需求 3）：微信 / QQ / ntfy 消息在岛内展示时用各自主题色。
                      整行是一个透明 Button —— 固定模式下岛只放行 Button 的点按（其余穿透），
                      做成 Button 才能"点得到"，同时点击直接打开这条消息。
                    -->
                    <Button x:Name="NoticeButton" Style="{StaticResource IslandRowButton}"
                            Visibility="Collapsed" Click="OnNoticeClick"
                            ToolTip="点击打开这条消息">
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center">
                                <Ellipse x:Name="NoticeDot" Width="7" Height="7" Fill="#07C160" />
                            </Grid>

                            <TextBlock x:Name="NoticeTag" Grid.Row="0" Grid.Column="1" Text="微信"
                                       FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"
                                       Foreground="#07C160" Opacity="1" VerticalAlignment="Center" />

                            <local:MarqueeText x:Name="NoticeText" Grid.Row="1" Grid.Column="1" Width="262"
                                               FontSize="12.5" Foreground="{DynamicResource IslandFg}"
                                               Margin="6,1,0,0" VerticalAlignment="Center" Text="" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

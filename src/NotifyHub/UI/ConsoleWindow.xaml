<Window x:Class="NotifyHub.UI.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotifyHub 控制台"
        Width="620" Height="420" MinWidth="460" MinHeight="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!--  标题栏图标按钮  -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#C7C7CC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  日志行：去掉选中高亮、零缩进，保证行高一致不重叠  -->
        <Style x:Key="LogItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="9,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" Background="#F418181C" CornerRadius="12"
            BorderBrush="#28FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#FF000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  标题栏：标题 + 状态 + 设置 / 折叠 / 关闭  -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="#34C759"
                            VerticalAlignment="Center" />
                    <TextBlock Text="NotifyHub 控制台" Margin="8,0,0,0" FontSize="12.5"
                               FontWeight="SemiBold" Foreground="#F2F2F7" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="StatusText" Margin="14,0,10,0" FontSize="11"
                           Foreground="#8A8A90" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0">
                    <Button x:Name="SettingsButton" Style="{StaticResource ChromeButton}"
                            Content="&#x2699;" ToolTip="设置" Click="OnSettingsClick" />
                    <Button x:Name="CollapseButton" Style="{StaticResource ChromeButton}"
                            Content="&#x25BE;" ToolTip="折叠 / 展开" Click="OnCollapseClick" />
                    <Button x:Name="CloseButton" Style="{StaticResource ChromeButton}"
                            Content="&#x2715;" ToolTip="关闭到托盘" Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <!--  日志区：等宽字体、12.5px、行高 20，深色低饱和  -->
            <Border Grid.Row="1" x:Name="Body" Margin="10,0,10,0" CornerRadius="8" Background="#FF121215"
                    BorderBrush="#1EFFFFFF" BorderThickness="1">
                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource LogItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Cascadia Mono, Courier New"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" />
            </Border>

            <!--  输入区：单行命令 + 发送  -->
            <Grid Grid.Row="2" x:Name="InputBar" Margin="10,8,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="8" Background="#FF111114"
                        BorderBrush="#26FFFFFF" BorderThickness="1">
                    <TextBox x:Name="CommandBox" Height="32" Margin="8,0" Background="Transparent"
                             BorderThickness="0" Foreground="#EDEDF2" CaretBrush="#EDEDF2"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12.5"
                             VerticalContentAlignment="Center"
                             KeyDown="OnCommandKeyDown"
                             ToolTip="输入 help 查看命令；Enter 发送" />
                </Border>

                <Button Grid.Column="1" x:Name="SendButton" Content="发送" Width="64" Height="32"
                        Margin="8,0,0,0" FontSize="12.5" Click="OnSendClick"
                        Background="#2F6BFF" Foreground="White" BorderBrush="#2F6BFF" />
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="NotifyHub.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NotifyHub 设置" Height="780" Width="920"
        MinHeight="620" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <!--
      v0.2.9 需求 6：设置界面改为毛玻璃。
        · 去掉系统标题栏（WindowStyle=None + AllowsTransparency），自绘一条可拖拽的标题栏；
        · 背景用高透明多层渐变 + 1px 高光描边（和通知卡/灵动岛同一套视觉，
          Win10 分层窗口拿不到 DWM 真模糊，这是等效实现）；
        · 所有前景/背景都走 DynamicResource，由代码按「系统深浅主题 + 背景实测亮度」注入，
          因此深色系统下不会再出现"白卡片配黑字"的割裂。
        · WindowChrome 保留边缘拖拽缩放，不然 AllowsTransparency 会让窗口变成不可调整大小。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!--  外观画刷：默认浅色兜底，运行时由 ApplyGlassChrome() 覆盖  -->
        <SolidColorBrush x:Key="AppFg" Color="#1C1C1E" />
        <SolidColorBrush x:Key="AppSubFg" Color="#7A7F88" />
        <SolidColorBrush x:Key="AppCard" Color="#B8FFFFFF" />
        <SolidColorBrush x:Key="AppInput" Color="#C6FFFFFF" />
        <SolidColorBrush x:Key="AppBorder" Color="#33000000" />
        <SolidColorBrush x:Key="AppHover" Color="#22000000" />

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="14,8,14,10" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="Background" Value="{DynamicResource AppCard}" />
            <Setter Property="Foreground" Value="{DynamicResource AppFg}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource AppFg}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--
          v0.2.10 需求 5：提示文案默认换行。
          以前这些长句没有 TextWrapping，而外层 ScrollViewer 又禁用了横向滚动 →
          超出宽度的部分被直接裁掉（"拦截关键词"那段说明、ntfy 地址说明都是这样被截断的）。
          现在三重保证：文案自己换行 + 容器用 WrapPanel + 外层允许横向滚动。
        -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource AppSubFg}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  自绘标题栏按钮（最小化 / 关闭）：无边框方形，悬停微亮  -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource AppFg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2,18,2" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,2,18,2" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinWidth" Value="88" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="150" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="SmallChange" Value="5" />
            <Setter Property="LargeChange" Value="10" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,6" />
        </Style>

        <!--  日志行：零缩进、行高统一、去掉选中高亮（只读，不需要选择）  -->
        <Style x:Key="LogItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="9,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--  毛玻璃外壳：圆角 + 1px 高光描边，背景由 ApplyGlassChrome() 按系统深浅注入  -->
    <Border x:Name="Shell" Margin="8" CornerRadius="12" BorderThickness="1"
            BorderBrush="{DynamicResource AppBorder}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F5F7F9FB" Offset="0" />
                <GradientStop Color="#EDEEF1F5" Offset="0.5" />
                <GradientStop Color="#E6E8ECF1" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="16,10,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  自绘标题栏（可拖拽 + 最小化/关闭）：WindowStyle=None 后系统标题栏不可用  -->
            <Grid Grid.Row="0" Margin="0,0,0,10" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NotifyHub" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppFg}" VerticalAlignment="Center" />
                    <TextBlock Text="桌面消息聚合 · 微信 / QQ / ntfy · 灵动岛" FontSize="12"
                               Foreground="{DynamicResource AppSubFg}"
                               VerticalAlignment="Center" Margin="10,2,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" Content="—" Style="{StaticResource CaptionButton}"
                            Click="OnMinimizeClick" ToolTip="最小化" />
                    <Button x:Name="CloseButton" Content="✕" Style="{StaticResource CaptionButton}"
                            Click="OnCloseClick" ToolTip="关闭" />
                </StackPanel>
            </Grid>

        <TabControl Grid.Row="1" x:Name="Tabs" Background="Transparent" BorderThickness="0">

            <!--  ================= 设置  =================  -->
            <TabItem Header="设置">
                <!--
                      横向保持 Disabled（内容被约束到视口宽度），这样文字才真的换行；
                      想靠横向滚动"藏起来"会让 Wrap 失效、所有提示变成一条超长横线。
                      不裁字靠的是：HintText 默认 Wrap + 控件行改用 WrapPanel。
                    -->
                <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SettingsContent" Margin="0,8,0,0">

                        <!--  ntfy 订阅（v0.2.4 多订阅）  -->
                        <GroupBox Header="ntfy 订阅">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource HintText}" Margin="0,0,0,6"
                                           Text="每个订阅独立开关、名称与通知颜色；地址填 https://ntfy.sh/你的主题 即可，程序自动补 /sse。点击通知会用浏览器打开对应主题的网页。" />

                                <!--  订阅列表（代码动态生成行）  -->
                                <StackPanel Grid.Row="1" x:Name="NtfyListPanel" />

                                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox x:Name="NtfyEnabledCheck" Content="启用 ntfy 订阅" MinWidth="118"
                                              VerticalAlignment="Center" />
                                    <Button x:Name="NtfyAddButton" Content="+ 添加订阅" MinWidth="96" Padding="10,3"
                                            FontSize="11.5" Click="OnNtfyAddClick" />
                                    <TextBlock Style="{StaticResource HintText}" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="名称会显示在通知卡顶部（如“ntfy · 家庭”），留空只显示 ntfy" />
                                </WrapPanel>
                            </Grid>
                        </GroupBox>

                        <!--  ntfy 下行推送（v0.2.4 需求 3）  -->
                        <GroupBox Header="ntfy 下行推送（WorkBuddy 任务进度 → 手机）">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="推送地址" Margin="0,0,10,0" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="NtfyPushUrlBox" Height="28"
                                         ToolTip="手机 ntfy App 订阅的同一个主题地址；留空 = 不下行推送" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource HintText}"
                                           Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="开启后：灵动岛里显示的 WorkBuddy 任务过程信息（与岛内完全一致的中文文本）会原样推送到这个地址，手机 ntfy App 订阅同一主题即可实时收到。不需要就留空。" />
                            </Grid>
                        </GroupBox>

                        <!--  监听与显示  -->
                        <GroupBox Header="监听与显示">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <CheckBox x:Name="WeChatCheck" Content="监听微信" />
                                        <CheckBox x:Name="QQCheck" Content="监听 QQ" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="轮询间隔" Margin="0,0,6,0" />
                                        <TextBox x:Name="IntervalBox" Width="64" Height="26" Margin="0,0,4,0" TextAlignment="Right" />
                                        <TextBlock Text="ms" Margin="0,0,14,0" Foreground="{DynamicResource AppSubFg}" />
                                        <TextBlock Text="四角弹窗" Margin="0,0,6,0" />
                                        <TextBlock Text="固定 10 秒" Width="64" Margin="0,0,4,0" TextAlignment="Right"
                                                   Foreground="{DynamicResource AppSubFg}" />
                                        <TextBlock Text="（v0.2.17 起写死，不随收纳时长变化）" Foreground="{DynamicResource AppSubFg}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="通知位置" Margin="0,0,10,0" />
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox x:Name="CornerCombo" Width="120" Height="26" FontSize="12.5" SelectedIndex="0">
                                            <ComboBoxItem Content="右上角" />
                                            <ComboBoxItem Content="左上角" />
                                            <ComboBoxItem Content="右下角" />
                                            <ComboBoxItem Content="左下角" />
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource HintText}" Margin="12,0,0,0"
                                                   Text="轮询间隔 300~2000ms，默认 300ms；通知时长 1000~30000ms" />
                                    </WrapPanel>
                                </Grid>

                                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox x:Name="AutoStartCheck" Content="开机自启" />
                                    <CheckBox x:Name="DumpOnStartCheck" Content="启动时导出 UIA 树（探测模式）" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="堆叠上限固定 5 条；鼠标悬停暂停倒计时；点击通知跳转聊天" />
                                </WrapPanel>
                            </Grid>
                        </GroupBox>

                        <!--  灵动岛  -->
                        <GroupBox Header="灵动岛">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="位置模式" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <RadioButton x:Name="IslandFixedRadio" Content="固定在顶部居中（不可拖动）"
                                                     GroupName="IslandMode" IsChecked="True" />
                                        <RadioButton x:Name="IslandFreeRadio" Content="自由拖动（按住空白区拖动，左键/右键均可）"
                                                     GroupName="IslandMode" />
                                    </StackPanel>
                                </Grid>

                                <!--  v0.2.20：自由拖动的子选项——是否也跟随超时收纳  -->
                                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="FreeAutoCollapseCheck" Content="自由拖动时也跟随超时收纳" IsChecked="True"
                                              ToolTip="勾选：到收纳时长后同样收成顶部窄条（自由模式下也能收起来）；取消：自由模式一直保持展开" />
                                    <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center"
                                               Text="只在「自由拖动」模式生效；固定模式始终跟随收纳时长" />
                                </WrapPanel>

                                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox x:Name="MusicEnabledCheck" Content="音乐控制模块" MinWidth="196" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="播放内置支持的音乐 App（网易云/QQ音乐/Spotify 等）时同一悬浮条内显示 上一首/播放暂停/下一首；无音频自动隐藏" />
                                </WrapPanel>

                                <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox x:Name="WbWatchCheck" Content="自动读取 WorkBuddy 任务进度" MinWidth="196" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="AI 的反馈文字实时上岛，回合结束报完成态并响完成音" />
                                </WrapPanel>

                                <Grid Grid.Row="4" Margin="24,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="长文本滚动速度" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="MarqueeSpeedSlider" Width="150" Minimum="10" Maximum="120"
                                                SmallChange="5" LargeChange="10" ValueChanged="OnMarqueeSpeedChanged" />
                                        <TextBlock x:Name="MarqueeSpeedText" Margin="8,0,0,0" MinWidth="70" Foreground="{DynamicResource AppSubFg}" Text="45" />
                                    </StackPanel>
                                </Grid>

                                <!--  v0.2.7 需求 2：超时自动收纳（开关 + 时长 + 音乐播放例外）  -->
                                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="24,10,0,0">
                                    <CheckBox x:Name="AutoCollapseCheck" Content="超时自动收纳" MinWidth="110"
                                              Checked="OnAutoCollapseToggled" Unchecked="OnAutoCollapseToggled"
                                              ToolTip="开启后：无新事件超过设定时长，灵动岛自动收成屏幕顶部细条" />
                                    <TextBlock Text="超时" Margin="0,0,8,0" />
                                    <Slider x:Name="AutoCollapseSlider" Width="120" Minimum="1" Maximum="60"
                                            IsSnapToTickEnabled="True" TickFrequency="1" />
                                    <TextBlock x:Name="AutoCollapseText" MinWidth="52" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AppSubFg}" Text="3 秒" />
                                    <CheckBox x:Name="KeepOpenWhilePlayingCheck" Content="音乐播放时保持展开"
                                              ToolTip="默认关：播放中也按上面的时长自动收纳（v0.2.17 统一时序）；勾选后播放期间一直显示歌词" />
                                    <CheckBox x:Name="SwipeCollapseCheck" Content="上滑收纳" Margin="16,0,0,0"
                                              ToolTip="展开的岛上短按鼠标并向上滑，直接收成窄收纳条；强制收纳后只有单击窄条/新通知/开始播放/启动任务才会再展开" />
                                </StackPanel>

                                <TextBlock Grid.Row="6" Style="{StaticResource HintText}" Margin="24,6,0,0" TextWrapping="Wrap"
                                           Text="统一收纳规则（v0.2.17）：新消息 / 新任务 / 开始播放都会把灵动岛弹出来，并按上面的时长重新计时，超时收成顶部细条；空闲（无任务/播放/通知）到点同样收纳，之后不会自动再展开。鼠标停在岛上时不计时。「音乐播放时保持展开」是例外开关，默认关闭。多应用共存时只展示活跃项（在放歌/在跑任务），空闲挂着的不占岛。" />

                                <TextBlock Grid.Row="7" Style="{StaticResource HintText}" Margin="24,6,0,0" TextWrapping="Wrap"
                                           Text="窄条交互：悬停 + 单击展开信息面板（含暂存的最新通知）；悬停 + 双击唤起对应应用并置顶。岛内有音乐/任务在跑时，新消息（微信/QQ/ntfy）一律走四角卡片（固定 10 秒收起），不在岛内混杂展示；只有岛内空闲时新通知才进岛。短按上滑可随时强制收纳。" />
                            </Grid>
                        </GroupBox>

                        <!--  灵动岛外观（v0.2.18：调参直接作用在屏幕顶部的真实岛上，无内嵌预览面板）  -->
                        <GroupBox Header="灵动岛外观（实况预览 · 直接看屏幕顶部的岛）">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  ============ 实况预览说明（v0.2.18 改版：不再有内嵌虚拟面板）  ============  -->
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="4" TextWrapping="Wrap"
                                           Style="{StaticResource HintText}"
                                           Text="下面任何一项改动都会立刻反映到屏幕顶部那条真实的灵动岛上（用固定的样板内容渲染，不受当前有没有在放歌/跑任务影响）。改坏了直接关掉设置窗即可，不点「保存并应用」就不会写进配置。" />

                                <!--  ============ 预览内容来源（v0.2.19 需求2：真实优先，样板兜底）  ============  -->
                                <WrapPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="预览内容" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <RadioButton x:Name="SceneAutoRadio" Content="真实状态（推荐）" GroupName="PreviewScene"
                                                 IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center"
                                                 ToolTip="在放歌/在跑任务时，直接用当前真实的岛来调参；没有真实内容时才用样板兜底" />
                                    <RadioButton x:Name="SceneMusicRadio" Content="仅音乐" GroupName="PreviewScene"
                                                 Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <RadioButton x:Name="SceneTaskRadio" Content="仅任务" GroupName="PreviewScene"
                                                 Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <RadioButton x:Name="SceneNoticeRadio" Content="仅通知" GroupName="PreviewScene"
                                                 Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <RadioButton x:Name="SceneBothRadio" Content="音乐+任务" GroupName="PreviewScene"
                                                 Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center"
                                               Text="默认用真实运行状态；没有真实内容时才用样板兜底，改任何参数立即同步到真实岛" />
                                </WrapPanel>

                                <!--  ============ 布局参数（v0.2.18 需求1：全部接入实时预览） ============  -->
                                <!--  滑块 1：岛总长度（v0.2.9 需求 6）  -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="长度" Margin="0,0,10,0" VerticalAlignment="Center"
                                           ToolTip="长度 = 岛的上下边长（水平方向）" />
                                <WrapPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="IslandWidthSlider" Width="140" Height="24"
                                            Minimum="100" Maximum="160" IsSnapToTickEnabled="True"
                                            TickFrequency="5" VerticalAlignment="Center"
                                            ToolTip="岛的长度 = 上下边长（水平方向）：100% = 508px 基准，100~160% 可调；内容再长也只在岛内滚动，不会把岛撑大" />
                                    <TextBlock x:Name="IslandWidthText" MinWidth="76" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AppSubFg}" Text="100% · 508px" />
                                </WrapPanel>

                                <!--  整体高度（v0.2.18 新增）  -->
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="高度" Margin="10,0,10,0" VerticalAlignment="Center"
                                           ToolTip="高度 = 岛的左右边长（垂直方向），70% 是上限" />
                                <WrapPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="IslandHeightSlider" Width="110" Height="24"
                                            Minimum="50" Maximum="80" IsSnapToTickEnabled="True"
                                            TickFrequency="2" VerticalAlignment="Center"
                                            ToolTip="岛的高度 = 左右边长（垂直方向）：70% ≈ 104px 为基准，50~80% 可调" />
                                    <TextBlock x:Name="IslandHeightText" MinWidth="76" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AppSubFg}" Text="70% · 104px" />
                                </WrapPanel>

                                <!--  滑块 2：左右区域分配比例（v0.2.9 需求 6）  -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="区域比例" Margin="0,10,10,0" VerticalAlignment="Center" />
                                <WrapPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <Slider x:Name="IslandSplitSlider" Width="130" Height="24" Margin="0,0,8,0"
                                            Minimum="25" Maximum="75" IsSnapToTickEnabled="True"
                                            TickFrequency="1" VerticalAlignment="Center"
                                            ToolTip="向左：播放器变窄、右侧变宽；向右：播放器变宽、右侧变窄" />
                                    <TextBlock x:Name="IslandSplitText" MinWidth="64"
                                               Foreground="{DynamicResource AppSubFg}" Text="50 : 50" />
                                </WrapPanel>

                                <!--  音乐模块尺寸（v0.2.18 新增）  -->
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="音乐模块" Margin="10,10,10,0" VerticalAlignment="Center" />
                                <WrapPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <Slider x:Name="MusicModuleSlider" Width="130" Height="24"
                                            Minimum="70" Maximum="140" IsSnapToTickEnabled="True"
                                            TickFrequency="5" VerticalAlignment="Center"
                                            ToolTip="缩放音乐行：图标 / 播放三键 / 歌名区宽度" />
                                    <TextBlock x:Name="MusicModuleText" MinWidth="52" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AppSubFg}" Text="100%" />
                                </WrapPanel>

                                <!--  歌词区域宽度（v0.2.18 新增）  -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="歌词宽度" Margin="0,10,10,0" VerticalAlignment="Center" />
                                <WrapPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <Slider x:Name="LyricsWidthSlider" Width="150" Height="24"
                                            Minimum="50" Maximum="160" IsSnapToTickEnabled="True"
                                            TickFrequency="5" VerticalAlignment="Center"
                                            ToolTip="歌词区域宽度上限的缩放系数（自适应宽度的基础上再缩放）" />
                                    <TextBlock x:Name="LyricsWidthText" MinWidth="52" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AppSubFg}" Text="100%" />
                                </WrapPanel>

                                <!--  播放器与歌词间距（v0.2.18 新增）  -->
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="播放器-歌词" Margin="10,10,10,0" VerticalAlignment="Center" />
                                <WrapPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <Slider x:Name="MusicLyricsGapSlider" Width="130" Height="24"
                                            Minimum="0" Maximum="24" IsSnapToTickEnabled="True"
                                            TickFrequency="1" VerticalAlignment="Center"
                                            ToolTip="播放器行与歌词区域之间的上下间距" />
                                    <TextBlock x:Name="MusicLyricsGapText" MinWidth="52" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AppSubFg}" Text="4 px" />
                                </WrapPanel>

                                <!--  歌词横向偏移（v0.2.18 新增）  -->
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="歌词横移" Margin="0,10,10,0" VerticalAlignment="Center" />
                                <WrapPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <Slider x:Name="LyricsOffsetXSlider" Width="150" Height="24"
                                            Minimum="-60" Maximum="120" IsSnapToTickEnabled="True"
                                            TickFrequency="4" VerticalAlignment="Center"
                                            ToolTip="歌词区域整体左右偏移（正数向右），微调用" />
                                    <TextBlock x:Name="LyricsOffsetXText" MinWidth="52" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AppSubFg}" Text="0 px" />
                                </WrapPanel>

                                <!--  WorkBuddy 模块尺寸（v0.2.18 新增）  -->
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="任务模块" Margin="10,10,10,0" VerticalAlignment="Center" />
                                <WrapPanel Grid.Row="5" Grid.Column="3" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <Slider x:Name="TaskModuleSlider" Width="130" Height="24"
                                            Minimum="70" Maximum="140" IsSnapToTickEnabled="True"
                                            TickFrequency="5" VerticalAlignment="Center"
                                            ToolTip="缩放任务/通知模块：正文字号与宽度上限" />
                                    <TextBlock x:Name="TaskModuleText" MinWidth="52" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AppSubFg}" Text="100%" />
                                </WrapPanel>

                                <!--  模块内行间距（v0.2.18 新增）  -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="任务行距" Margin="0,10,10,0" VerticalAlignment="Center" />
                                <WrapPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <Slider x:Name="TaskLineSpacingSlider" Width="150" Height="24"
                                            Minimum="0" Maximum="20" IsSnapToTickEnabled="True"
                                            TickFrequency="1" VerticalAlignment="Center"
                                            ToolTip="任务模块内“来源标签行 / 正文行”的上下间距" />
                                    <TextBlock x:Name="TaskLineSpacingText" MinWidth="52" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AppSubFg}" Text="4 px" />
                                </WrapPanel>

                                <!--  模块上下偏移（v0.2.18 新增）  -->
                                <TextBlock Grid.Row="6" Grid.Column="2" Text="任务上下" Margin="10,10,10,0" VerticalAlignment="Center" />
                                <WrapPanel Grid.Row="6" Grid.Column="3" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <Slider x:Name="TaskOffsetYSlider" Width="130" Height="24"
                                            Minimum="-24" Maximum="24" IsSnapToTickEnabled="True"
                                            TickFrequency="2" VerticalAlignment="Center"
                                            ToolTip="任务模块在岛内的上下位置偏移（正数向下）" />
                                    <TextBlock x:Name="TaskOffsetYText" MinWidth="52" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AppSubFg}" Text="0 px" />
                                </WrapPanel>

                                <!--  歌词总开关 + 字号（与"音乐播放时保持展开"互相独立）  -->
                                <WrapPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4"
                                            Orientation="Horizontal" Margin="0,12,0,0">
                                    <CheckBox x:Name="LyricsEnabledCheck" Content="显示歌词" MinWidth="92" />
                                    <TextBlock Text="歌词字号" Margin="0,0,8,0" />
                                    <Slider x:Name="LyricsFontSizeSlider" Width="120" Minimum="10" Maximum="22"
                                            IsSnapToTickEnabled="True" TickFrequency="1" />
                                    <TextBlock x:Name="LyricsFontSizeText" MinWidth="48" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AppSubFg}" Text="13" />
                                    <TextBlock Style="{StaticResource HintText}" Text="关掉后即使保持展开也不显示歌词（与上面的保持展开互相独立）" />
                                </WrapPanel>

                                <!--
                                  歌词来源与时间微调（v0.2.12 需求 1）：
                                  本地 .lrc（播放器缓存 / 歌曲同目录）优先，本地没有才联网，且只认严格匹配。
                                -->
                                <WrapPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="4"
                                            Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox x:Name="LyricsNetworkCheck" MinWidth="0"
                                              Content="本地没词时联网兜底（只接受歌名+歌手都对上的结果）" />
                                    <TextBlock Text="时间微调" Margin="18,0,8,0" />
                                    <Slider x:Name="LyricOffsetSlider" Width="130"
                                            Minimum="-2000" Maximum="2000"
                                            IsSnapToTickEnabled="True" TickFrequency="50"
                                            ToolTip="整体提前/延后歌词，正数=提前显示" />
                                    <TextBlock x:Name="LyricOffsetText" MinWidth="64" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AppSubFg}" Text="0 ms" />
                                </WrapPanel>

                                <!--  外观说明：主题固定为毛玻璃，跟随系统深浅，文字自动保证对比度  -->
                                <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="4"
                                           Style="{StaticResource HintText}" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Text="外观固定为毛玻璃（半透明可见下层内容，深浅跟随 Windows 应用主题，文字颜色按背景实测亮度自动选对比度更高的一侧）。上面所有参数都直接渲染到屏幕顶部那条真实的灵动岛上，改任何参数立即生效；点「保存并应用」才写入配置，不保存关掉本窗就恢复原样。" />
                            </Grid>
                        </GroupBox>

                        <!--  浏览器选择（v0.2.4 需求 7：四选项）  -->
                        <GroupBox Header="浏览器（点击 ntfy 通知时打开主题网页）">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="浏览器" Margin="0,0,10,0" />
                                <WrapPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox x:Name="BrowserChoiceCombo" Width="150" Height="26" FontSize="12.5"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="系统默认浏览器" Tag="System" />
                                        <ComboBoxItem Content="Google Chrome" Tag="Chrome" />
                                        <ComboBoxItem Content="Microsoft Edge" Tag="Edge" />
                                        <ComboBoxItem Content="夸克浏览器" Tag="Quark" />
                                        <ComboBoxItem Content="其他（拖入快捷方式）" Tag="Other" />
                                    </ComboBox>
                                    <TextBlock x:Name="BrowserPathHint" Style="{StaticResource HintText}"
                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Text="点击 ntfy 通知时用系统默认浏览器打开主题网页" />
                                </WrapPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="浏览器路径" Margin="0,8,10,0"
                                           x:Name="BrowserPathLabel" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0"
                                            x:Name="BrowserPathRow">
                                    <TextBox x:Name="BrowserPathBox" Width="320" Height="28"
                                             AllowDrop="True"
                                             PreviewDragOver="OnBrowserPathDragOver"
                                             Drop="OnBrowserPathDrop"
                                             ToolTip="把桌面浏览器快捷方式拖进来，或直接粘贴 .exe / .lnk 路径" />
                                    <Button x:Name="BrowserBrowseButton" Content="浏览…" MinWidth="64" Padding="10,3"
                                            FontSize="11.5" Click="OnBrowserBrowseClick" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource HintText}"
                                           Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="选前三项时程序自动在常见安装位置定位浏览器（未安装会提示并回退系统默认）；选“其他”可把桌面快捷方式直接拖入上方输入框，或粘贴快捷方式/程序路径，程序会调用它打开 ntfy 订阅地址。" />
                            </Grid>
                        </GroupBox>

                        <!--  两套独立提示音  -->
                        <GroupBox Header="提示音（两套互相独立）">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <CheckBox x:Name="MessageSoundCheck" Content="消息通知提示音" Width="128" />
                                    <TextBlock Text="音色" Margin="0,0,6,0" />
                                    <ComboBox x:Name="MessageSoundCombo" Width="104" Height="26" FontSize="12.5" SelectedIndex="0">
                                        <ComboBoxItem Content="叮咚" Tag="DingDong" />
                                        <ComboBoxItem Content="清脆" Tag="Crystal" />
                                        <ComboBoxItem Content="水泡" Tag="Bubble" />
                                        <ComboBoxItem Content="木琴" Tag="Marimba" />
                                        <ComboBoxItem Content="电子" Tag="Digital" />
                                    </ComboBox>
                                    <TextBlock Text="音量" Margin="12,0,6,0" />
                                    <Slider x:Name="MessageVolumeSlider" Value="80" ValueChanged="OnMessageVolumeChanged" />
                                    <TextBlock x:Name="MessageVolumeText" Margin="8,0,0,0" MinWidth="34" Foreground="{DynamicResource AppSubFg}" Text="80%" />
                                    <Button x:Name="MessageTestButton" Content="试听" MinWidth="52" Padding="10,3"
                                            Margin="10,0,0,0" FontSize="11.5" Click="OnMessageSoundTestClick" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox x:Name="TaskSoundCheck" Content="任务完成提示音" Width="128" />
                                    <TextBlock Text="音色" Margin="0,0,6,0" />
                                    <ComboBox x:Name="TaskSoundCombo" Width="104" Height="26" FontSize="12.5" SelectedIndex="0">
                                        <ComboBoxItem Content="上行三音" Tag="Ascend" />
                                        <ComboBoxItem Content="成功双音" Tag="Success" />
                                        <ComboBoxItem Content="铃声" Tag="Bell" />
                                        <ComboBoxItem Content="和弦" Tag="Chord" />
                                    </ComboBox>
                                    <TextBlock Text="音量" Margin="12,0,6,0" />
                                    <Slider x:Name="TaskVolumeSlider" Value="80" ValueChanged="OnTaskVolumeChanged" />
                                    <TextBlock x:Name="TaskVolumeText" Margin="8,0,0,0" MinWidth="34" Foreground="{DynamicResource AppSubFg}" Text="80%" />
                                    <Button x:Name="TaskTestButton" Content="试听" MinWidth="52" Padding="10,3"
                                            Margin="10,0,0,0" FontSize="11.5" Click="OnTaskSoundTestClick" />
                                </StackPanel>

                                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox x:Name="SuppressAppSoundsCheck" Content="自动静音微信/QQ 自带提示音" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="勾选后：本应用消息提示音开启时，自动静音微信与 QQ 自己的提示音，只保留本应用的音效（关闭恢复）" />
                                </WrapPanel>

                                <TextBlock Grid.Row="3" Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="仅放行的聊天消息播放提示音，被过滤的消息不发声；任务完成提示音在 WorkBuddy 完成态出现时播放，与消息提示音互相独立。" />
                            </Grid>
                        </GroupBox>

                        <!--  微信过滤  -->
                        <GroupBox Header="微信通知过滤">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                          x:Name="WeChatFilterCheck" Content="启用过滤（放行他人私聊/普通群聊，屏蔽官方会话与免打扰）" />

                                <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                          x:Name="WeChatAllowChatMultimediaCheck"
                                          Content="好友/群聊的多媒体（图片/视频/表情包/语音/文件）一律放行" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="拦截关键词" Margin="0,8,10,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="FilterKeywordsBox" Height="28" Margin="0,8,0,0" />

                                <WrapPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                    <Button x:Name="FeedbackButton" Content="误拦截反馈…" Padding="14,6"
                                            Click="OnFeedbackClick"
                                            ToolTip="某条消息被错误拦截了？选一条记录或手动填写后提交，保存成 JSON 并复制到剪贴板" />
                                    <TextBlock Style="{StaticResource HintText}" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="提交后保存在反馈目录，可直接打包发给开发者" />
                                </WrapPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource HintText}"
                                           Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="判定拆成两个维度：来源渠道标签（官方/免打扰/好友群聊/自己发送）只作风险权重记录在日志里；内容类型（图片/视频/表情包/语音/文件）单独识别——好友/群聊里的多媒体一律放行，修掉私聊图片因缺少未读证据被当成“自己发的”而拦掉的误伤。官方会话与免打扰会话按渠道标签拦截（那是你显式要的静音/过滤）。拦截关键词是你自己的追加黑名单（逗号分隔），命中会话名或摘要即拦截。QQ 不过滤。" />
                            </Grid>
                        </GroupBox>

                        <!--  诊断与反馈（v0.2.10 需求 6）：手动导出 Bug 快照  -->
                        <GroupBox Header="诊断与反馈">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0">
                                    <Button x:Name="ExportSnapshotButton" Content="导出 Bug 快照"
                                            Padding="14,6" Click="OnExportSnapshotClick"
                                            ToolTip="截一张整屏图，并收集前后各 10 秒的核心模块日志与当前配置" />
                                    <Button x:Name="OpenSnapshotButton" Content="查看快照"
                                            Padding="14,6" Click="OnOpenSnapshotClick" />
                                    <TextBlock x:Name="SnapshotStatus" Style="{StaticResource HintText}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="仅在点击时采集，平时不占 CPU / 内存" />
                                </WrapPanel>

                                <TextBlock Grid.Row="1" Style="{StaticResource HintText}" Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="快照包含：整屏截图 + 点击前后各 10 秒的五个核心模块日志（歌词 / 灵动岛布局 / 通知渲染 / 设置UI / 交互控制）+ 当前整套配置。产出一个独立目录，查看页左边截图、右边对应时段日志，可直接打包发给开发者。" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  ================= 运行日志（原独立控制台已合并到这里）  =================  -->
            <TabItem Header="运行日志">
                <Grid Margin="0,10,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                    </Grid.RowDefinitions>

                    <!--  工具条  -->
                    <Grid Grid.Row="0" Margin="0,0,0,7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="LogStatusText" Style="{StaticResource HintText}"
                                   TextTrimming="CharacterEllipsis" Text="最近 600 行 · 自动滚到底" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <CheckBox x:Name="AutoScrollCheck" Content="自动滚动" IsChecked="True"
                                      Margin="0,0,10,0" FontSize="11.5" />
                            <Button Content="清空日志" Click="OnClearLogInlineClick" MinWidth="76"
                                    Padding="10,3" FontSize="11.5" Margin="0"
                                    Background="#FEE2E2" Foreground="#B91C1C" BorderBrush="#FCA5A5" />
                        </StackPanel>

                        <!--  日志目录（v0.2.4 需求 8：可自定义）  -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="日志目录" FontSize="11.5" Foreground="{DynamicResource AppSubFg}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="LogDirText" FontSize="11.5" Foreground="{DynamicResource AppFg}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       MaxWidth="560" />
                            <Button x:Name="LogDirEditButton" Content="更改目录…" MinWidth="76" Padding="10,3"
                                    FontSize="11.5" Margin="10,0,0,0" Click="OnLogDirEditClick" />
                            <Button x:Name="LogDirOpenButton" Content="打开目录" MinWidth="76" Padding="10,3"
                                    FontSize="11.5" Margin="6,0,0,0" Click="OnOpenLogClick" />
                        </StackPanel>
                    </Grid>

                    <!--  详细日志：等宽字体、按级别着色、只读  -->
                    <Border Grid.Row="1" CornerRadius="8" Background="#FF121215"
                            BorderBrush="#1EFFFFFF" BorderThickness="1">
                        <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource LogItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Cascadia Mono, Courier New"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" />
                    </Border>

                    <TextBlock Grid.Row="2" Text="最近 50 条事件" FontWeight="SemiBold" Margin="2,10,0,5" />

                    <ListView Grid.Row="3" x:Name="EventList" BorderThickness="1" BorderBrush="{DynamicResource AppBorder}"
                              Background="{DynamicResource AppInput}" FontSize="12"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="时间" Width="74" DisplayMemberBinding="{Binding TimeText}" />
                                <GridViewColumn Header="来源" Width="52" DisplayMemberBinding="{Binding Source}" />
                                <GridViewColumn Header="发件人" Width="140" DisplayMemberBinding="{Binding Sender}" />
                                <GridViewColumn Header="内容" Width="400" DisplayMemberBinding="{Binding Content}" />
                                <GridViewColumn Header="状态" Width="56" DisplayMemberBinding="{Binding StatusText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>

        <!--  操作按钮固定在底部：内容区滚动时不会把"保存"滚出视野  -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="SaveButton" Content="保存并应用" Click="OnSaveClick" Background="#2563EB" Foreground="White" BorderBrush="#1D4ED8" />
            <Button Content="取消" Click="OnCancelClick" />
            <Button x:Name="TestButton" Content="测试通知" Click="OnTestClick" />
            <Button x:Name="DumpButton" Content="导出 UIA 树" Click="OnDumpClick" />
            <Button Content="打开日志目录" Click="OnOpenLogClick" />
            <Button x:Name="ClearLogsButton" Content="一键清除日志" Click="OnClearLogsClick"
                    Background="#FEE2E2" Foreground="#B91C1C" BorderBrush="#FCA5A5" />
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="{DynamicResource AppSubFg}"
                   Margin="2,6,0,0" TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>

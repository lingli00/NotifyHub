<Window x:Class="NotifyHub.UI.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotifyHub.UI"
        Title="NotifyHub 通知"
        Width="384" Height="140"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" Focusable="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal"
        FontFamily="SF Pro Display SC, SF Pro Display, SF Pro Text, PingFang SC, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="Manual">

    <!--
      macOS 原生通知样式（v0.2.6 支持两套外观）：
        顶部：应用图标 + 来源名称（微信 / QQ / NTFY）
        中间：会话名称（好友昵称 / 群名）
        主体：消息预览（跑马灯，超宽横滚）
        底部：时间标签
      背景/文字颜色由代码按 ThemePalette 注入（纯色暗黑 / 深色毛玻璃 / 浅色毛玻璃），
      XAML 里的颜色只是设计期兜底。Margin 14 的透明留白保留，配合 Win32 HTTRANSPARENT 穿透。
    -->
    <Border x:Name="Card" Margin="14" CornerRadius="20"
            BorderBrush="#26FFFFFF" BorderThickness="1"
            Cursor="Hand" MouseLeftButtonUp="OnCardLeftUp" MouseRightButtonUp="OnCardRightClick"
            MouseLeftButtonDown="OnCardMouseDown" MouseMove="OnCardMouseMove">
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardTransform" X="40" />
        </Border.RenderTransform>

        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FA313136" Offset="0" />
                <GradientStop Color="#F92A2A2F" Offset="0.42" />
                <GradientStop Color="#F2151518" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!--  毛玻璃质感：顶部一条极淡高光（纯色主题下几乎不可见）  -->
            <Border x:Name="HighlightLayer" CornerRadius="20,20,20,20" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#14FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.45" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="16,13,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  顶部：应用图标 + 来源名称  -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="AppIcon" Width="18" Height="18" CornerRadius="5"
                            VerticalAlignment="Center" Background="#07C160">
                        <TextBlock x:Name="IconGlyph" Text="微" FontSize="10.5" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="AppNameText" Margin="8,0,0,0" FontSize="12" FontWeight="Medium"
                               Foreground="#C7C7CC" VerticalAlignment="Center" Text="微信" />
                </StackPanel>

                <!--  中间：会话名称  -->
                <TextBlock x:Name="SenderText" Grid.Row="1" Margin="0,7,0,0" FontSize="15"
                           FontWeight="SemiBold" Foreground="#FFFFFF"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                <!--  主体：消息预览（跑马灯：超宽横滚、悬停暂停、短文本居中）  -->
                <local:MarqueeText x:Name="ContentText" Grid.Row="2" Margin="0,4,0,0" FontSize="13"
                           Foreground="#B9B9C0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                <!--  底部：时间标签  -->
                <TextBlock x:Name="TimeText" Grid.Row="3" Margin="0,5,0,0" FontSize="11"
                           Foreground="#8A8A90" Text="00:00" />
            </Grid>
        </Grid>
    </Border>
</Window>

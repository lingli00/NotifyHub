<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10 TFM：引入 WinRT 投影（System Media Transport Controls），
         用于统一读取/控制各音乐播放器（网易云 / QQ音乐 / Spotify / Folia 等） -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NotifyHub</AssemblyName>
    <RootNamespace>NotifyHub</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NotifyHub.ico</ApplicationIcon>
    <Version>0.2.1</Version>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <FileVersion>0.2.1.0</FileVersion>
    <Company>NotifyHub</Company>
    <Product>NotifyHub</Product>
    <Description>桌面消息聚合通知工具（微信 / QQ / ntfy）+ 灵动岛任务与音乐状态</Description>

    <!-- 发布形态：自包含单文件，免安装 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>

    <!-- UIA 客户端只支持 Windows，项目本身就是 net8.0-windows -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <!-- System.Windows.Automation 由 WindowsDesktop 共享框架提供，SDK 自动引用，
       无需（也不应）显式加 Reference，否则触发版本冲突警告 -->

  <ItemGroup>
    <Resource Include="Assets\NotifyHub.ico" />
  </ItemGroup>

</Project>

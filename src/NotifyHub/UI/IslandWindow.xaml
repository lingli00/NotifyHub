<Window x:Class="NotifyHub.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotifyHub.UI"
        Title="NotifyHub 灵动岛"
        SizeToContent="WidthAndHeight" MaxWidth="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" Focusable="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!--  播放控件图标一律用矢量 Path 绘制：不依赖任何图标字体，
             避免缺字时按钮变成豆腐方块（Segoe MDL2 Assets 在精简系统上可能缺失）  -->
        <Geometry x:Key="GlyphPrev">M0,0 L2.3,0 L2.3,12 L0,12 Z M11,0.6 L11,11.4 L3,6 Z</Geometry>
        <Geometry x:Key="GlyphNext">M0,0.6 L0,11.4 L8,6 Z M8.7,0 L11,0 L11,12 L8.7,12 Z</Geometry>
        <Geometry x:Key="GlyphPlay">M0.8,0.4 L11.2,6 L0.8,11.6 Z</Geometry>
        <Geometry x:Key="GlyphPause">M0.8,0 L4,0 L4,12 L0.8,12 Z M7.4,0 L10.6,0 L10.6,12 L7.4,12 Z</Geometry>

        <!--  v0.2.6 主题画刷：由 ThemePalette 在运行时替换（DynamicResource 会跟着刷新）  -->
        <SolidColorBrush x:Key="IslandFg" Color="#F2F2F7" />
        <SolidColorBrush x:Key="IslandSubFg" Color="#B9B9C0" />
        <SolidColorBrush x:Key="IslandGlyph" Color="#F2F2F7" />
        <SolidColorBrush x:Key="IslandHover" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="IslandPress" Color="#55FFFFFF" />
        <SolidColorBrush x:Key="IslandAccent" Color="#FFD60A" />
        <SolidColorBrush x:Key="IslandDivider" Color="#33FFFFFF" />

        <!--  岛内快捷按钮：点击区域 36×36，透明底、悬停微亮，不抢焦点  -->
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{DynamicResource IslandFg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IslandHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IslandPress}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
      统一毛玻璃圆角长条：音乐信息 + 播放控件 + 单行任务状态（+ v0.2.6 双行歌词）。

      布局（v0.2.6 需求 5，采用方案 A「L 形」）：
        第 0 行： [♪] 歌名-歌手 | [⏮] [⏯] [⏭]
        第 1 行：     双行歌词（跑马灯，仅音乐在播且有歌词时展开）
        右侧   ： 任务状态单行（跨两行垂直居中）
      无任务时只有音乐+歌词（自然收窄）；有任务时右侧补上进度，整体仍是 L 形。
      背景由 ThemePalette 注入（纯色暗黑 / 深色毛玻璃 / 浅色毛玻璃）。
    -->
    <Border x:Name="Pill" Margin="14" CornerRadius="22" BorderBrush="#26FFFFFF" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F23A3A40" Offset="0" />
                <GradientStop Color="#F22C2C31" Offset="0.35" />
                <GradientStop Color="#EE0F0F12" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.RenderTransform>
            <TranslateTransform x:Name="IslandShift" Y="-10" />
        </Border.RenderTransform>

        <Grid>
            <!--  毛玻璃顶部高光：一条极淡的白色渐变，让半透明面板有“玻璃”的层次  -->
            <Border x:Name="HighlightLayer" CornerRadius="22" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#14FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.5" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  音乐组：App 图标 + 歌名（跑马灯）+ 三个控件  -->
                <StackPanel x:Name="MusicGroup" Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                            Height="48" VerticalAlignment="Center" Margin="6,0,2,0">
                    <!--  当前播放音乐 App 的透明圆角图标（需求 5）：无播放/提不到图标时收起  -->
                    <Border x:Name="MusicIconBox" Width="20" Height="20" CornerRadius="6"
                            VerticalAlignment="Center" Margin="0,0,7,0" Visibility="Collapsed">
                        <Image x:Name="MusicAppIcon" Width="20" Height="20" Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="MusicGlyph" Text="&#x266A;" FontSize="15"
                               Foreground="{DynamicResource IslandAccent}"
                               VerticalAlignment="Center" Margin="4,0,7,0" />
                    <local:MarqueeText x:Name="MusicText" Width="180" FontSize="12.5"
                               Foreground="{DynamicResource IslandFg}"
                               VerticalAlignment="Center" Text="正在播放" />
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="PrevButton" Style="{StaticResource IslandButton}"
                                Click="OnPrevClick" ToolTip="上一首">
                            <Path Data="{StaticResource GlyphPrev}" Fill="{DynamicResource IslandGlyph}"
                                  Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource IslandButton}"
                                Margin="2,0" Click="OnPlayPauseClick" ToolTip="播放 / 暂停">
                            <Path x:Name="PlayPauseGlyph" Data="{StaticResource GlyphPlay}"
                                  Fill="{DynamicResource IslandGlyph}"
                                  Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource IslandButton}"
                                Click="OnNextClick" ToolTip="下一首">
                            <Path Data="{StaticResource GlyphNext}" Fill="{DynamicResource IslandGlyph}"
                                  Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!--  双行歌词（v0.2.6 需求 5）：当前行 + 下一行，跑马灯滚动  -->
                <StackPanel x:Name="LyricsPanel" Grid.Row="1" Grid.Column="0"
                            Orientation="Vertical" Margin="33,0,2,9" Visibility="Collapsed">
                    <local:MarqueeText x:Name="LyricLine1" Width="286" FontSize="11.5"
                                       Foreground="{DynamicResource IslandFg}"
                                       VerticalAlignment="Center" Text="" />
                    <local:MarqueeText x:Name="LyricLine2" Width="286" FontSize="11.5" Margin="0,3,0,0"
                                       Foreground="{DynamicResource IslandSubFg}"
                                       VerticalAlignment="Center" Text="" />
                </StackPanel>

                <!--  两组之间的细分隔线（跨两行）  -->
                <Border x:Name="Divider" Grid.Column="1" Grid.RowSpan="2" Width="1" Height="20"
                        Background="{DynamicResource IslandDivider}"
                        Margin="8,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" />

                <!--  单行任务组：状态点 / 对勾 + 一行实时动作文字（只许一行，超长末尾省略）  -->
                <StackPanel x:Name="StatusGroup" Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="4,0,12,0" MinHeight="48">
                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FFB020" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="DotScale" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Path x:Name="CheckGlyph" Data="M1,6.6 L4.6,10.4 L11,1.8" Stroke="#34C759"
                              StrokeThickness="2.1" Width="12" Height="12" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Visibility="Collapsed" HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Grid>

                    <!--  任务状态文字：跑马灯（超宽横滚、悬停暂停、短文本居中）  -->
                    <local:MarqueeText x:Name="StatusText" Width="440" FontSize="13"
                               Foreground="{DynamicResource IslandFg}" VerticalAlignment="Center"
                               Margin="9,0,12,0" Text="正在执行任务…" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
